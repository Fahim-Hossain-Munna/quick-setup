{
  "name": "fahimhossainmunna/quick-setup",
  "description": "Laravel quick setup command package that automates .env setup, composer/npm install, migrations, storage link, and cache clear.",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Fahim Hossain Munna",
      "email": "fhmunna.dev@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "symfony/process": "^6.0 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "Fahimhossainmunna\\QuickSetup\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Fahimhossainmunna\\QuickSetup\\QuickSetupServiceProvider"
      ]
    }
  }
}
